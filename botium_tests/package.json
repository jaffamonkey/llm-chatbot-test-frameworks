{
  "name": "botium-dialogflow-tests",
  "version": "1.0.0",
  "description": "Automated Botium test suite for Dialogflow",
  "scripts": {
    "test": "mocha spec",
    "test:report": "mocha spec --reporter mochawesome --reporter-options reportDir=reports"
  },
  "dependencies": {
    "botium-connector-dialogflow": "^0.1.3"
  },
  "devDependencies": {
    "botium-bindings": "^1.0.0",
    "botium-cli": "^1.1.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3"
  },
  "botium": {
    "convodirs": [
      "spec/convo"
    ],
    "expandConvos": true,
    "expandUtterancesToConvos": false,
    "expandScriptingMemoryToConvos": false
  }
}